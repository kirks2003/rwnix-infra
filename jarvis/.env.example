PORT=8094
PUBLIC_BASE_PATH=/
# Conversation history database (the Prompt/Answer panels' scrollback). Every
# finished turn is stored per user in this SQLite file; GET /api/conversation
# serves it windowed to ?days=N (default 24, clamped 1..365). In the container
# deployment point this at the jarvis_data volume (see docker-compose.yml) so
# the history survives rebuilds; the default is a per-process file in the
# temp dir (fine for `node server.js` and the tests).
CONVERSATION_DB_PATH=/data/conversations.db
# Comma-separated user names; each user's password is their own name
# (Mila signs in with "Mila"/"Mila"). Admins (ADMIN_USERS) must be in this list.
USERS=Mila,Roman,admin
# Comma-separated subset of USERS that get the admin session (global graph
# panel, global activity feed, cross-owner brain reads, admin write/delete
# tools). Default: admin.
ADMIN_USERS=admin
WAKE_PHRASE=Hey Rocky
SILENCE_MS=1500
WHISPER_ENDPOINTS=https://voice.gpu-1-ch-dk-2.nwfp-nwt-cdc-it.csdc-nm.at/v1/audio/transcriptions
WHISPER_MODEL=Systran/faster-whisper-large-v3
WHISPER_LANGUAGE=en
WHISPER_VAD_FILTER=true
WHISPER_API_KEY=
# Optional selector entries. The UI exposes gpu-1 and vm103; unset values use
# the defaults below. The vm103 service is usually unauthenticated on the mesh.
WHISPER_GPU1_ENDPOINTS=https://voice.gpu-1-ch-dk-2.nwfp-nwt-cdc-it.csdc-nm.at/v1/audio/transcriptions
WHISPER_GPU1_MODEL=Systran/faster-whisper-large-v3
WHISPER_GPU1_API_KEY=
WHISPER_VM103_ENDPOINTS=http://192.168.53.111:8003/v1/audio/transcriptions
WHISPER_VM103_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_VM103_API_KEY=
WHISPER_OVHCLOUD_ENDPOINTS=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1/audio/transcriptions
WHISPER_OVHCLOUD_MODEL=whisper-large-v3
# Defaults to BRAIN_OVHCLOUD_API_KEY/OVH_AI_ENDPOINTS_ACCESS_TOKEN when empty.
WHISPER_OVHCLOUD_API_KEY=
# OVH's OpenAI-compatible Whisper endpoint rejects faster-whisper's vad_filter
# field, so Jarvis deliberately does not send it for this profile.
BRAIN_BASE_URL=https://ds4-flash.gpu-2-de-fra-1-exo.csdc-nm.at/v1
BRAIN_MODEL=deepseek-v4-flash
BRAIN_API_KEY=
# The AI endpoint selector is populated from the local opencode/Kandev profile
# config when readable, with these env vars taking precedence per provider.
BRAIN_PROFILE_DEFAULT=a1-deepseek
BRAIN_A1_QWEN_BASE_URL=https://qwen38-27b-mtp.gpu-1-ch-dk-2.nwfp-nwt-cdc-it.csdc-nm.at/v1
BRAIN_A1_QWEN_MODEL=Qwen3.8-27B-UD-Q8_K_XL.gguf
BRAIN_A1_QWEN_API_KEY=
BRAIN_OVHCLOUD_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
BRAIN_OVHCLOUD_MODEL=Qwen3.6-27B
BRAIN_OVHCLOUD_API_KEY=
BRAIN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BRAIN_OPENROUTER_MODEL=qwen/qwen3.8-27b
BRAIN_OPENROUTER_API_KEY=
BRAIN_CLAUDECODE_BASE_URL=
BRAIN_CLAUDECODE_MODEL=opus
BRAIN_CLAUDECODE_API_KEY=
BRAIN_SYSTEM_PROMPT=You are Jarvis, a concise voice assistant. Answer in English, be helpful, and keep spoken answers short.
TTS_ENDPOINTS=https://voice.gpu-1-ch-dk-2.nwfp-nwt-cdc-it.csdc-nm.at/v1/audio/speech
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=bm_george
TTS_API_KEY=
# Neo4j knowledge graph (see DEPLOYMENT.md, "Knowledge graph"). Leave the
# NEO4J_* variables empty to run without the graph; everything degrades to
# "not configured" and the brain/panel report it as such.
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
# Read-only user for the brain context, the panel and the brain's MCP queries.
NEO4J_READ_USER=jarvis_read
NEO4J_READ_PASSWORD=
# Write user used by the backend's turn ingestion and the admin session's
# MCP write/delete tools (store-entity, store-fact, delete-entity); the MCP
# server only opens a write driver when this is set.
NEO4J_WRITE_USER=jarvis_write
NEO4J_WRITE_PASSWORD=
# Admin password for the neo4j service (NEO4J_AUTH) and one-off maintenance.
NEO4J_ADMIN_PASSWORD=
# The neo4j-mcp server connection (stdio child of the backend). Read-only is
# forced by the backend; these are its connection settings.
NEO4J_MCP_URI=bolt://neo4j:7687
NEO4J_MCP_DATABASE=neo4j
NEO4J_MCP_USERNAME=jarvis_read
NEO4J_MCP_PASSWORD=
# Vikunja (task manager) — region-pinned service MCP (see AGENTS.md and
# vikunja-mcp.md). Leave VIKUNJA_URLS empty to run without Vikunja; the MCP
# switch simply does not appear. Region policy: a request entering through
# the nbg-1 gateway may only use the nbg-1 instance, vie-1 only vie-1 — the
# region comes from the public Host header of the /api/chat request, and
# direct internal access falls back to VIKUNJA_DEFAULT_REGION.
# VIKUNJA_URLS: JSON map region -> API base URL of that region's instance
# (the SSH tunnels on this host: 127.0.0.1:34561 = nbg-1, 127.0.0.1:34562 =
# vie-1). VIKUNJA_TOKENS: JSON map region -> user -> that user's OWN Vikunja
# API token (title "jarvis"), minted per gateway host; the token is the
# scope, so the brain acts as the user's own Vikunja account. No delete
# tier is enabled (VIKUNJA_MCP_ALLOW_DELETE stays unset).
VIKUNJA_URLS=
VIKUNJA_TOKENS=
VIKUNJA_DEFAULT_REGION=
